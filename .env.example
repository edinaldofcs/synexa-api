# ==============================================================================
# Synexa API - Environment Variables Template
# ==============================================================================

# Runtime Role: api | voice | worker | worker-ingestion | worker-agent | worker-dispatcher | worker-media | worker-knowledge | worker-dlq
SERVICE_ROLE=api

# Environment: development | staging | production
ENVIRONMENT=development
NODE_ENV=development
PORT=3000
VOICE_PORT=3001

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:synexapassword@localhost:5435/synexa_db?schema=public
DIRECT_URL=postgresql://postgres:synexapassword@localhost:5435/synexa_db?schema=public

# Cache & Queues (Redis)
REDIS_URL=redis://:synexa-redis-dev@localhost:6379
# Redis password (must match the compose redis-server --requirepass)
REDIS_PASSWORD=synexa-redis-dev

# Security & Auth (32+ chars in production)
JWT_SECRET=
ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:5173
AUTH_COOKIE_SAME_SITE=lax
# Configure these in deployments where API and frontend use different origins.
# AUTH_CALLBACK_URL=https://app.example.com/api/auth/callback
# AUTH_FRONTEND_URL=https://app.example.com
BODY_LIMIT=5mb
UPLOAD_MAX_SIZE=52428800

# Providers Configuration:
# AUTH_PROVIDER: local | supabase
AUTH_PROVIDER=local

# STORAGE_PROVIDER: local | supabase | s3
STORAGE_PROVIDER=local

# LLM_PROVIDER: mock | gemini | groq | openrouter
LLM_PROVIDER=mock

# VOICE_PROVIDER: mock | gemini
VOICE_PROVIDER=mock

# Mock Latency Simulation
MOCK_LLM_LATENCY_MS=80
MOCK_VOICE_LATENCY_MS=40

# Real Providers (Optional in local development)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4-mini

# Supabase (Required if AUTH_PROVIDER=supabase or STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_PUBLISH_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seed settings
SEED_ADMIN_PASSWORD=
