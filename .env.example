# NODE Environment (development / production)
NODE_ENV=development

# Server Port
PORT=3000

# Prisma Database connection URL (Connection Pooler)
DATABASE_URL=postgresql://<user>.<project_ref>:<password>@<host>:<port>/postgres?pgbouncer=true

# Prisma Direct Database connection URL (Direct Connection)
DIRECT_URL=postgresql://<user>.<project_ref>:<password>@<host>:<port>/postgres

# Supabase Project Configuration
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_PUBLISH_KEY=<publishable_key>
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Redis
REDIS_URL=redis://localhost:6379

# Orquestrador LLM
LLM_PROVIDER=gemini
LLM_MAX_RETRIES=2
GEMINI_API_KEY=<gemini_key>
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=<groq_key>
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=<openrouter_key>
OPENROUTER_MODEL=openai/gpt-5.4-nano:nitro
EXTERNAL_TOOL_TIMEOUT=30000
