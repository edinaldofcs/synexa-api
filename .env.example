# =============================================================
# REQUIRED FOR ALL ENVIRONMENTS
# =============================================================

# Prisma Database connection URL (Connection Pooler)
DATABASE_URL=postgresql://<user>.<project_ref>:<password>@<host>:<port>/postgres?pgbouncer=true

# Redis connection URL
REDIS_URL=redis://localhost:6379

# JWT Secret for token signing (minimum 32 characters in production)
# Required in all environments
JWT_SECRET=<generate-a-strong-random-secret-at-least-32-chars>

# =============================================================
# REQUIRED FOR STAGING & PRODUCTION
# =============================================================

# Supabase Project Configuration
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# =============================================================
# OPTIONAL
# =============================================================

# Environment: development | staging | production
# Default: development
ENVIRONMENT=development

# NODE Environment: development | production
# Default: development
NODE_ENV=development

# Server Port (default: 3000)
PORT=3000

# Prisma Direct Database connection URL (Direct Connection)
DIRECT_URL=postgresql://<user>.<project_ref>:<password>@<host>:<port>/postgres

# Supabase publishable key (client-side, not used server-side)
SUPABASE_PUBLISH_KEY=<publishable_key>

# CORS Origin (comma-separated, default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Body limit for incoming requests (default: 1mb)
BODY_LIMIT=1mb

# LLM Provider: gemini | groq | openrouter
LLM_PROVIDER=gemini

# Maximum LLM retries (default: 2)
LLM_MAX_RETRIES=2

# Gemini API configuration
GEMINI_API_KEY=<gemini_key>
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq API configuration
GROQ_API_KEY=<groq_key>
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter API configuration
OPENROUTER_API_KEY=<openrouter_key>
OPENROUTER_MODEL=openai/gpt-5.4-nano:nitro
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Synexa

# Timeout for external tools in ms (default: 30000)
EXTERNAL_TOOL_TIMEOUT=30000
