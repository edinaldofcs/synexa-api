# Configuração para Ambiente Staging / Homologação
SERVICE_ROLE=api
ENVIRONMENT=staging
NODE_ENV=production
PORT=3000
VOICE_PORT=3001

DATABASE_URL=postgresql://postgres:[PASSWORD]@[STAGING_DB_HOST]:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[STAGING_DB_HOST]:5432/postgres
REDIS_URL=rediss://default:[REDIS_PASSWORD]@[STAGING_REDIS_HOST]:6379

JWT_SECRET=[STAGING_JWT_SECRET_MIN_32_CHARS]
ENCRYPTION_KEY=[STAGING_ENCRYPTION_KEY_MIN_32_CHARS]
CORS_ORIGIN=https://staging.synexa.app

AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase
LLM_PROVIDER=gemini
VOICE_PROVIDER=gemini

SUPABASE_URL=https://[STAGING_PROJECT_ID].supabase.co
SUPABASE_PUBLISH_KEY=sb_publishable_[STAGING_KEY]
SUPABASE_SERVICE_ROLE_KEY=sb_secret_[STAGING_SERVICE_ROLE_KEY]

GEMINI_API_KEY=[STAGING_GEMINI_API_KEY]
GEMINI_MODEL=gemini-2.5-flash-lite
