{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^file-type$": "<rootDir>/../src/media/__mocks__/file-type.ts"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(jose|jwks-rsa|uuid)/)"
  ]
}
